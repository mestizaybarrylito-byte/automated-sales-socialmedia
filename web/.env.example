# Public Supabase config (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL (used for catalog image URLs; safe for the browser bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only — NEVER prefix with NEXT_PUBLIC_ / NEVER commit real values
# SUPABASE_SERVICE_ROLE_KEY=
# CLIP_API_KEY=
# WHATSAPP_CLOUD_API_TOKEN=
# META_MODEL_API_KEY=

# WhatsApp catalog sync (server-side only)
# WHATSAPP_CATALOG_ID=
# Catalog sending is stubbed unless explicitly enabled:
WHATSAPP_CATALOG_SEND_ENABLED=false

# Live trends feeds (server-side only). Defaults point at the public Google
# Trends "Trending Now" RSS for the selected country; override per country
# code only if your network blocks them (e.g. TRENDS_FEED_ES, TRENDS_FEED_AR).
# TRENDS_FEED_MX=https://trends.google.com/trending/rss?geo=MX
# TRENDS_FEED_US=https://trends.google.com/trending/rss?geo=US

# Dynamic style catalog (public: fetched by the browser). JSON document with
# `{ "styles": [...] }` — see lib/style-catalog.ts for the entry schema.
# Unset = use the 53-style bundle; invalid/unreachable = fall back to it.
# NEXT_PUBLIC_STYLE_CATALOG_URL=https://example.com/styles.json
