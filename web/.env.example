# --- Meta Model API (server-side only; never expose to the client) ---
# Base URL of the OpenAI-compatible inference endpoint, e.g. https://<host>/v1
META_MODEL_BASE_URL=
# API key for the model endpoint. Keep in web/.env.local (gitignored). NEVER commit.
META_MODEL_API_KEY=
# Model name sent in the chat/completions payload.
META_MODEL_NAME=
# Optional overrides (code defaults shown).
# META_MODEL_WONDER_NAME=muse-wonder-1.0
# META_MODEL_IMAGE_NAME=muse-image-1.0
# META_MODEL_VOICE_NAME=muse-voice-transcribe-1.0
# META_MODEL_SAM_NAME=sam-3.1

# --- AI agents (defaults shown) ---
# AI_AGENTS_DIR=../agents_orig
# CONTEXT_FILE_PATH=../context/BUSINESS_CONTEXT_SHEET.md
